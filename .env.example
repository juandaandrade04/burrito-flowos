# ─────────────────────────────────────────────
#  Burrito FlowOS - Variables de Entorno
#  Copiar este archivo como .env y completar
# ─────────────────────────────────────────────

# Puerto del servidor
PORT=3000

# Conexión a MongoDB
# Local:  mongodb://localhost:27017/burrito_flowos
# Atlas:  mongodb+srv://usuario:contraseña@cluster.mongodb.net/burrito_flowos
MONGO_URI=mongodb://localhost:27017/burrito_flowos

# Clave secreta JWT: reemplazar por una clave larga y aleatoria
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# Clave secreta para firmar las cookies de sesión (express-session)
SESSION_SECRET=burrito_flowos_session_secret_2026

# Entorno
NODE_ENV=development

# URLs de microservicios para ejecutar el gateway fuera de Docker
AUTH_SERVICE_URL=http://localhost:4002
INVENTORY_SERVICE_URL=http://localhost:4001
RECETAS_SERVICE_URL=http://localhost:4003
SALES_SERVICE_URL=http://localhost:4004
