# ─────────────────────────────────────────────
#  Burrito FlowOS - Variables de Entorno
#  Copiar este archivo como .env y completar
# ─────────────────────────────────────────────

# Puerto del servidor
PORT=3000

# Conexión a MongoDB
# Local:  mongodb://localhost:27017/burrito_flowos
# Atlas:  mongodb+srv://usuario:contraseña@cluster.mongodb.net/burrito_flowos
MONGO_URI=mongodb://localhost:27017/burrito_flowos

# Clave secreta para firmar JWT (cambiar en producción)
JWT_SECRET=burrito_flowos_super_secret_key_2026
JWT_EXPIRES_IN=8h

# Entorno
NODE_ENV=development
