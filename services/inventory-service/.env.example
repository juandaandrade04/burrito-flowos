# ─────────────────────────────────────────────
#  Burrito FlowOS - inventory-service
#  Servicio de Insumos (Inventario)
#  Copiar este archivo como .env y completar
# ─────────────────────────────────────────────

# Puerto del servicio de inventario
PORT=4001

# Conexión a MongoDB (misma BD que el monolith durante la migración incremental)
MONGO_URI=mongodb://localhost:27017/burrito_flowos

# Clave secreta para verificar JWT (debe coincidir con la del emisor de tokens)
JWT_SECRET=burrito_flowos_super_secret_key_2026

# Entorno
NODE_ENV=development