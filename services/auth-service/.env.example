# ─────────────────────────────────────────────
#  Burrito FlowOS - auth-service
#  Servicio de Autenticación
#  Copiar este archivo como .env y completar
# ─────────────────────────────────────────────

# Puerto del servicio de autenticación
PORT=4002

# Conexión a MongoDB (misma BD que el monolith durante la migración incremental)
MONGO_URI=mongodb://localhost:27017/burrito_flowos

# Clave secreta para firmar JWT (DEBE coincidir con la que verifica el monolith e inventory-service)
JWT_SECRET=burrito_flowos_super_secret_key_2026
JWT_EXPIRES_IN=8h

# Entorno
NODE_ENV=development